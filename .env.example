# Application
APP_NAME=Pinky Bread
APP_ENV=development
DEV_MODE=true

# Browser authentication. Development credentials are local-only defaults.
AUTH_ENABLED=true
DEV_AUTH_ENABLED=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional Google OAuth 2.0 web application credentials.
# Add http://localhost:8888/auth/google/callback (or your Codespaces URL callback) in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Host port binding. Use 0.0.0.0 in Codespaces if port forwarding needs it.
PB_BIND_ADDRESS=127.0.0.1

# Host-run API processes use localhost; Docker Compose containers use Docker service DNS.
# The Compose stack starts Ollama and pulls this model into the persistent volume.
# Set MOCK_INFERENCE=true only when you intentionally want simulated responses.
MOCK_INFERENCE=false
MODEL_PROVIDER=ollama
REASONING_API_URL=http://127.0.0.1:11434/v1
REASONING_CONTAINER_API_URL=http://ollama:11434/v1
REASONING_MODEL=qwen2.5:3b
MULTIMODAL_API_URL=http://127.0.0.1:8002/v1
MULTIMODAL_MODEL=local-vision
VLLM_API_KEY=ollama

# Optional commercial LLM credentials. Keep these in .env only; never put API keys in agent profiles.
# Create keys in the provider consoles and monitor usage / billing with the provider.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional key for a custom OpenAI-compatible gateway (vLLM, hosted inference, etc.).
OPENAI_COMPATIBLE_API_KEY=

# Local API-only development uses SQLite and creates its schema automatically.
# For the full durable workforce stack, use: docker compose up --build
DATABASE_URL=sqlite:///./data/pinky_bread.db
AUTO_CREATE_SCHEMA=true
# PostgreSQL example for a local PostgreSQL server:
# DATABASE_URL=postgresql+psycopg://pinky_bread:YOUR_PASSWORD@localhost:5432/pinky_bread
REDIS_URL=redis://localhost:6379/0

# Local or S3-compatible object storage (SeaweedFS in Compose).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pinky-bread
S3_ACCESS_KEY=pinky_bread_dev
S3_SECRET_KEY=change-this-development-secret
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=12

# Agent manifests
AGENT_CONFIG_DIR=./config/agents

# Durable worker coordination. PostgreSQL owns jobs and checkpoints;
# Valkey is a notification/wakeup layer only.
WORKER_POLL_SECONDS=1.5
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=20
WORKER_MAX_ATTEMPTS=5
LANGGRAPH_STRICT_MSGPACK=true

# MCP Streamable HTTP.
# Standalone mode is disabled by default. Docker Compose enables MCP for API/worker.
# Static bearer tokens are development-only; replace both values with long random secrets.
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:8060/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8060
MCP_API_TOKEN=replace-with-a-long-random-workforce-token
MCP_READ_TOKEN=replace-with-a-different-read-only-token
MCP_RESOURCE_URL=http://127.0.0.1:8060/mcp
MCP_ISSUER_URL=http://127.0.0.1:8888/issuer
MCP_MAX_TOOL_ROUNDS=4
