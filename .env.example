# Application
APP_NAME=Pinky Bread
APP_ENV=development
DEV_MODE=true

# Local inference. Mock mode is GPU-free; set false to use your local model API.
MOCK_INFERENCE=true
MODEL_PROVIDER=vllm
REASONING_API_URL=http://127.0.0.1:8001/v1
REASONING_MODEL=local-reasoner
MULTIMODAL_API_URL=http://127.0.0.1:8002/v1
MULTIMODAL_MODEL=local-vision
VLLM_API_KEY=local-dev-key

# PostgreSQL is required for the durable workforce worker and LangGraph checkpoints.
# SQLite remains supported for API-only lightweight development.
DATABASE_URL=postgresql+psycopg://pinky_bread:pinky_bread_dev_only@localhost:5432/pinky_bread
REDIS_URL=redis://localhost:6379/0

# Local or S3-compatible object storage (SeaweedFS in Compose).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pinky-bread
S3_ACCESS_KEY=pinky_bread_dev
S3_SECRET_KEY=change-this-development-secret
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=12

# Agent manifests
AGENT_CONFIG_DIR=./config/agents

# Durable worker coordination. PostgreSQL owns jobs and checkpoints;
# Valkey is a notification/wakeup layer only.
WORKER_POLL_SECONDS=1.5
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=20
WORKER_MAX_ATTEMPTS=5
LANGGRAPH_STRICT_MSGPACK=true

# MCP Streamable HTTP.
# Static bearer tokens are a development-only verifier, not Keycloak/OIDC.
# Use long random values and keep the MCP listener on a private network.
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:8090/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_API_TOKEN=replace-with-a-long-random-workforce-token
MCP_READ_TOKEN=replace-with-a-different-read-only-token
MCP_RESOURCE_URL=http://127.0.0.1:8090/mcp
MCP_ISSUER_URL=http://127.0.0.1:8080/issuer
MCP_MAX_TOOL_ROUNDS=4
