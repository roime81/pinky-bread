APP_NAME=Pinky Bread
APP_ENV=development
DEV_MODE=true
MOCK_INFERENCE=true
DATABASE_URL=sqlite:///./data/pinky_bread.db
REDIS_URL=redis://localhost:6379/0
AGENT_CONFIG_DIR=./config/agents
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=12
REASONING_API_URL=http://localhost:8001/v1
REASONING_MODEL=local-reasoner
MULTIMODAL_API_URL=http://localhost:8002/v1
MULTIMODAL_MODEL=local-vision
VLLM_API_KEY=local-dev-key
